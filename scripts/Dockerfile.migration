FROM node:24-alpine

WORKDIR /app

# Install only the migration script's own minimal dependencies
# (mongoose + ts-node/typescript), not the whole app's dependency tree.
COPY scripts/package.json scripts/package-lock.json ./
RUN npm ci

COPY scripts/migrate-data.ts scripts/tsconfig.json ./scripts/
COPY .db ./.db

ENV NODE_ENV=production

CMD ["npx", "ts-node", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
