{
  "id": null,
  "uid": "container-metrics",
  "title": "Container Metrics (cAdvisor)",
  "description": "Per-container CPU/memory/network from cAdvisor. Filters to id=~\"/docker/.*\" so host-level systemd cgroups (also scraped by cAdvisor) don't clutter the view - if you see 'No data', confirm cAdvisor can see your Docker daemon's cgroups (some restricted/nested Docker environments limit this; a normal local Docker install does not).",
  "tags": ["easyshop", "infrastructure", "docker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage by Container",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{image!=\"\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory Usage by Container",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (name) (container_memory_usage_bytes{image!=\"\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network Receive by Container",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{image!=\"\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network Transmit by Container",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{image!=\"\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    }
  ]
}
