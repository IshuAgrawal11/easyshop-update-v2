# Copy this file to .env for local development / docker compose.
# Never commit the real .env file — it is gitignored on purpose.

# --- Database ---
# Local docker compose (with Mongo auth enabled): include credentials in the URI.
MONGODB_URI=mongodb://easyshop_app:REPLACE_WITH_APP_PASSWORD@easyshop-mongodb:27017/easyshop?authSource=easyshop

# Mongo root credentials used only to initialize the database container (docker-compose.yml).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_ROOT_PASSWORD

# Application-level database user created for the app to use day-to-day (least privilege).
MONGO_APP_USERNAME=easyshop_app
MONGO_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD

# Read-only clusterMonitor-role user for mongodb-exporter — deliberately
# separate from the app's readWrite user above.
MONGO_EXPORTER_USERNAME=mongodb_exporter
MONGO_EXPORTER_PASSWORD=REPLACE_WITH_EXPORTER_PASSWORD

# --- App URLs ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Leave both empty for local testing: migrate-data.ts then emits local image
# paths (e.g. /groceryImages/apple.png) served straight from public/, instead
# of prefixing them with a CDN. Fill these in once you have a real CDN.
CDN_HOSTNAME=
CDN_URL=

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# --- Observability ---
OTEL_SERVICE_NAME=easyshop
# Where the app sends traces — the OTel Collector, not Jaeger directly.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Bearer token Prometheus must send to scrape /api/metrics. Generate with: openssl rand -hex 32
METRICS_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
