{
  "title": "EasyShop — MongoDB",
  "uid": "easyshop-mongodb",
  "tags": ["easyshop", "mongodb"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Exporter up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "mongodb_up", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        { "expr": "mongodb_ss_connections{conn_type=\"current\"}", "legendFormat": "current", "refId": "A" },
        { "expr": "mongodb_ss_connections{conn_type=\"available\"}", "legendFormat": "available", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "title": "Operations/sec by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(mongodb_ss_opcounters[5m])",
          "legendFormat": "{{legacy_op_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memory usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] },
      "targets": [
        { "expr": "mongodb_ss_mem_resident", "legendFormat": "resident", "refId": "A" },
        { "expr": "mongodb_ss_mem_virtual", "legendFormat": "virtual", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "title": "Document operations/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(mongodb_ss_metrics_document[5m])",
          "legendFormat": "{{doc_op_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Network bytes/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "expr": "rate(mongodb_ss_network_bytesIn[5m])", "legendFormat": "in", "refId": "A" },
        { "expr": "rate(mongodb_ss_network_bytesOut[5m])", "legendFormat": "out", "refId": "B" }
      ]
    }
  ]
}
